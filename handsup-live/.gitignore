# secrets
.env
.env.*
!.env.example
*.pem
*.key

# data & models: never commit
datasets/raw/
datasets/processed/
*.mp4
*.mov
*.avi
*.webm
*.npy
*.npz
*.parquet
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
ml/runs/
ml/checkpoints/

# build / deps
node_modules/
.next/
dist/
build/
.expo/
__pycache__/
