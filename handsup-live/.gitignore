*.pyc

# local
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/locks/
.claude/settings.local.json

# self-hosted MediaPipe assets (copied from node_modules / downloaded with approval; hashes are in mediapipe-assets.json)
apps/web/public/mediapipe/
apps/web/public/models/*
!apps/web/public/models/.gitkeep
*.task
# /live assets (copied and SHA-256-checked by apps/web/scripts/sync-live-assets.mjs; PHOENIX-derived demo landmarks are never committed)
apps/web/public/demo/

# handsupai.com deploy folder (holds model files; built by scripts/build-handsupai.mjs)
deploy/handsupai/public/
deploy/handsupai/.wrangler/

# demo app (apps/demo): files copied in by apps/demo/scripts/sync-assets.mjs, never committed
apps/demo/public/models/
apps/demo/public/mediapipe/
apps/demo/public/demo/

# /pharmacy demo data (PopSign-derived landmarks; built by scripts/build-pharmacy-signs.mjs)
apps/web/public/pharmacy/
